│   ├── PratosFavoritosController.java
│   ├── UserController.java
│   └── ValorNutricionalController.java
│
├── email/                           # Serviço de e-mail e templates
│   ├── EmailService.java            # Manipulação do JavaMailSender e MimeMessage
│   └── template-email.html          # Template HTML base
│
├── exception/
│   └── TratadorErros.java           # @RestControllerAdvice para interceptação de erros
│
├── model/                           # Entidades JPA (Mapeamento Objeto-Relacional)
│   ├── Avaliacoes.java
│   ├── Avisos.java
│   ├── Cardapio.java
│   ├── CardapioDia.java
│   ├── Categoria.java
│   ├── Notificacoes.java
│   ├── Pratos.java
│   ├── PratosFavoritos.java
│   ├── User.java
│   └── ValorNutricional.java
│
└── repository/                      # Interfaces Spring Data JPA
    ├── AvaliacoesRepository.java
    ├── AvisosRepository.java
    ├── CardapioDiaRepository.java
    ├── CardapioRepository.java
    ├── CategoriaRepository.java
    ├── NotificacoesRepository.java
    ├── PratosFavoritosRepository.java
    ├── PratosRepository.java
    ├── UserRepository.java
    └── ValorNutricionalRepository.java
```

